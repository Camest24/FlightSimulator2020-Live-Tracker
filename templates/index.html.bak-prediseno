      <h1>Progreso del vuelo</h1>
      <svg id="pg-caret" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9h14M5 15h14"/></svg>
    </div>
    <div class="pg-body">
      <div class="pg-ends">
        <span class="pg-end from"><span class="pg-icao" id="pg-from">----</span><span class="pg-city" id="pg-from-name"></span></span>
          <span class="pg-mid"><span class="pg-plane-badge" id="pg-badge" title="Fase del vuelo"><svg id="pg-badge-icon" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M21 16v-2l-8-5V3.5C13 2.67 12.33 2 11.5 2S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5L21 16z"/></svg></span></span>
