<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
// Línea magenta del plan de vuelo del propio MSFS. La dejamos oculta porque se superpone
// con la ruta de la app; el código queda intacto por si algún día la querés de vuelta.
const FPLAN_LINE_VISIBLE=false;

const labelPaint={ 'text-color':'#fff','text-halo-color':'rgba(0,0,0,0.6)','text-halo-width':1.4,'text-halo-blur':0.4 };
const nameField=['coalesce',['get','name:latin'],['get','name']];
const labelLayers=[
  {id:'lbl-country','source-layer':'place',filter:['==',['get','class'],'country'],maxzoom:8,layout:{'text-field':nameField,'text-font':['Noto Sans Bold'],'text-transform':'uppercase','text-letter-spacing':0.1,'text-size':['interpolate',['linear'],['zoom'],2,10,6,15]}},
  {id:'lbl-state','source-layer':'place',filter:['==',['get','class'],'state'],maxzoom:9,layout:{'text-field':nameField,'text-font':['Noto Sans Regular'],'text-transform':'uppercase','text-letter-spacing':0.2,'text-size':['interpolate',['linear'],['zoom'],5,10,9,14]}},
  {id:'lbl-city','source-layer':'place',filter:['==',['get','class'],'city'],layout:{'text-field':nameField,'text-font':['Noto Sans Bold'],'text-size':['interpolate',['exponential',1.2],['zoom'],5,13,10,19],'text-max-width':8}},
  {id:'lbl-town','source-layer':'place',filter:['==',['get','class'],'town'],minzoom:7,layout:{'text-field':nameField,'text-font':['Noto Sans Regular'],'text-size':['interpolate',['exponential',1.2],['zoom'],8,12,13,16],'text-max-width':8}},
  {id:'lbl-village','source-layer':'place',filter:['==',['get','class'],'village'],minzoom:10,layout:{'text-field':nameField,'text-font':['Noto Sans Regular'],'text-size':['interpolate',['exponential',1.2],['zoom'],11,11,15,14],'text-max-width':8}},
].map(l=>({id:l.id,type:'symbol',source:'omt','source-layer':l['source-layer'],filter:l.filter,minzoom:l.minzoom||0,maxzoom:l.maxzoom||24,layout:Object.assign({'text-optional':true,visibility:'visible'},l.layout),paint:labelPaint}));

const rlayer=(id,vis)=>({id,type:'raster',source:id,layout:{visibility:vis?'visible':'none'}});
const style={version:8,glyphs:'https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf',
  sources:{
    sat:{type:'raster',tiles:['https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'],tileSize:256,maxzoom:19},
    street:{type:'raster',tiles:['https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png'],tileSize:256,maxzoom:19},
    dark:{type:'raster',tiles:['https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}.png'],tileSize:256,maxzoom:19},
    omt:{type:'vector',url:'https://tiles.openfreemap.org/planet'},
  },
  layers:[rlayer('sat',true),rlayer('street',false),rlayer('dark',false),...labelLayers],
};

const map=new maplibregl.Map({container:'map',style,center:[-75.45,6.28],zoom:12,pitch:60,attributionControl:false});
// Rotación habilitada: el ícono del avión usa rotationAlignment 'map', así que se corrige solo

const labelIds=labelLayers.map(l=>l.id);
function setBase(name){ const v=(id,on)=>map.setLayoutProperty(id,'visibility',on?'visible':'none');
  v('sat',name==='satlabels'||name==='satellite'); v('street',name==='street'); v('dark',name==='dark');
  labelIds.forEach(id=>v(id,name==='satlabels')); }
document.querySelectorAll('.layer-opt').forEach(o=>o.addEventListener('click',()=>{
  document.querySelectorAll('.layer-opt').forEach(x=>x.classList.remove('sel')); o.classList.add('sel'); setBase(o.dataset.layer); }));
document.getElementById('btn-layers').addEventListener('click',()=>{ document.getElementById('layers').classList.toggle('hidden'); document.getElementById('btn-layers').classList.toggle('active'); });
// Los botones de zoom no deben soltar el seguimiento: si estás siguiendo al avión,
// hacemos el zoom centrado en él en vez de dejar que se corra de la pantalla.
function zoomBoton(delta){
  if(followMode && meMarker) map.easeTo({zoom:map.getZoom()+delta, center:meMarker.getLngLat(), duration:280});
  else if(delta>0) map.zoomIn(); else map.zoomOut();
}
document.getElementById('zin').onclick=()=>zoomBoton(1);
document.getElementById('zout').onclick=()=>zoomBoton(-1);

// Brújula (abajo a la derecha): gira con el mapa y al tocarla vuelve al norte
document.getElementById('compass').onclick=()=>map.easeTo({bearing:0,duration:400});
function syncCompass(){
  const c=document.getElementById('compass-rose');
  if(c) c.style.transform='rotate('+(-map.getBearing())+'deg)';
}
map.on('rotate',syncCompass);
syncCompass();

// Vista 2D / 3D (inclinación del mapa). Animamos el pitch nosotros mismos, cuadro a
// cuadro con setPitch instantáneo, para que el recentrado del seguimiento no la cancele.
function tiltTo(target){
  const start=map.getPitch(), t0=performance.now(), dur=450;
  (function step(now){
    let k=Math.min(1,(now-t0)/dur);
    const e=1-Math.pow(1-k,3);            // easeOutCubic
    map.setPitch(start+(target-start)*e);
    if(k<1) requestAnimationFrame(step);
  })(performance.now());
}
document.getElementById('btn-3d').onclick=()=>{
  const to3d = map.getPitch() < 20;
  tiltTo(to3d?60:0);
  const b=document.getElementById('btn-3d');
  b.textContent = to3d?'3D':'2D';   // muestra el modo en el que quedás
  b.classList.toggle('active', to3d);
};

// Colapsar / desplegar el panel de datos
document.getElementById('panel-head').addEventListener('click',()=>{
  document.getElementById('panel').classList.toggle('collapsed');
});
document.getElementById('row-alt').addEventListener('click',()=>{
  document.getElementById('row-alt').classList.toggle('collapsed');
});

function dest(lat,lon,brg,d){const R=6378137,b=brg*Math.PI/180,dd=d/R,la1=lat*Math.PI/180,lo1=lon*Math.PI/180;
  const la2=Math.asin(Math.sin(la1)*Math.cos(dd)+Math.cos(la1)*Math.sin(dd)*Math.cos(b));
  const lo2=lo1+Math.atan2(Math.sin(b)*Math.sin(dd)*Math.cos(la1),Math.cos(dd)-Math.sin(la1)*Math.sin(la2));
  return [lo2*180/Math.PI,la2*180/Math.PI];}
function runwayShape(clat,clon,hdg,len,wid){const f=dest(clat,clon,hdg,len/2),b=dest(clat,clon,hdg+180,len/2);
  return {poly:[dest(f[1],f[0],hdg+90,wid/2),dest(f[1],f[0],hdg-90,wid/2),dest(b[1],b[0],hdg-90,wid/2),dest(b[1],b[0],hdg+90,wid/2)],center:[f,b]};}

// Color continuo por altitud: interpola entre los tramos, así el trazo cambia de color
// suavemente (azul -> azul claro -> verde...) en vez de saltar de golpe.
// Escala de Flightradar24: blanco casi en tierra, después amarillo, verde, celeste,
// azul, violeta, y rojo en lo más alto. Los cortes vienen de sus umbrales en metros
// (100 m para el amarillo, 2500 m para el celeste) pasados a pies.
const ALT_STOPS=[
  [0,     [255,255,255]],   // blanco     · menos de 100 m
  [330,   [250,204,21]],    // amarillo
  [3300,  [74,222,128]],    // verde
  [8200,  [56,189,248]],    // celeste    · desde 2500 m
  [16000, [37,99,235]],     // azul
  [28000, [30,58,138]],     // azul oscuro · acá cae el crucero típico
  [40000, [124,58,237]],    // violeta
  [48000, [239,68,68]],     // rojo        · muy alto, casi nunca
];
function altColor(ft){ ft=ft||0;
  if(ft<=ALT_STOPS[0][0]) return 'rgb('+ALT_STOPS[0][1].join(',')+')';
  for(let i=0;i<ALT_STOPS.length-1;i++){ const a=ALT_STOPS[i], b=ALT_STOPS[i+1];
    if(ft<=b[0]){ const k=(ft-a[0])/(b[0]-a[0]);
      return 'rgb('+Math.round(a[1][0]+(b[1][0]-a[1][0])*k)+','+Math.round(a[1][1]+(b[1][1]-a[1][1])*k)+','+Math.round(a[1][2]+(b[1][2]-a[1][2])*k)+')'; } }
  return 'rgb('+ALT_STOPS[ALT_STOPS.length-1][1].join(',')+')'; }
function fmtDur(min){ if(min==null)return '00:00:00'; const s=Math.max(0,Math.round(min*60)); const h=Math.floor(s/3600),m=Math.floor((s%3600)/60),ss=s%60; return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(ss).padStart(2,'0'); }
function fmtEnd(min){ if(min==null)return ''; const h=Math.floor(min/60),m=Math.round(min%60); return '~'+(h>0?h+'h ':'')+m+'m'; }
const nf=n=>n.toLocaleString('en-US');

function planeSVG(fill,size,stroke){ return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="${fill}" ${stroke?`stroke="${stroke}" stroke-width="0.6"`:''}><path d="M12 2c-.5 0-1 .5-1 1.5V9L3 14v2l8-2.5V19l-2 1.5V22l3-1 3 1v-1.5L13 19v-5.5L21 16v-2l-8-5V3.5C13 2.5 12.5 2 12 2z"/></svg>`; }
// Silueta de A320 vista desde arriba (fuselaje + alas en flecha + 2 motores), apunta al norte
function planeSilhouette(fill,size,stroke){ return `<svg width="${size}" height="${size}" viewBox="0 0 48 48" fill="${fill}" ${stroke?`stroke="${stroke}" stroke-width="0.8" stroke-linejoin="round"`:''}><path d="M24 4C22.6 4 21.6 5.4 21.6 7.5L21.6 20 5 30 5 33 21.6 27.5 21.6 37 16.5 41 16.5 44 24 42 31.5 44 31.5 41 26.4 37 26.4 27.5 43 33 43 30 26.4 20 26.4 7.5C26.4 5.4 25.4 4 24 4Z"/><ellipse cx="13.6" cy="25.4" rx="1.7" ry="3"/><ellipse cx="34.4" cy="25.4" rx="1.7" ry="3"/></svg>`; }
// Jet pesado (4 motores)
function planeQuadJet(fill,size,stroke){ return `<svg width="${size}" height="${size}" viewBox="0 0 48 48" fill="${fill}" ${stroke?`stroke="${stroke}" stroke-width="0.8" stroke-linejoin="round"`:''}><path d="M24 4C22.6 4 21.6 5.4 21.6 7.5L21.6 20 5 30 5 33 21.6 27.5 21.6 37 16.5 41 16.5 44 24 42 31.5 44 31.5 41 26.4 37 26.4 27.5 43 33 43 30 26.4 20 26.4 7.5C26.4 5.4 25.4 4 24 4Z"/><ellipse cx="12.5" cy="27" rx="1.5" ry="2.6"/><ellipse cx="17" cy="24.6" rx="1.5" ry="2.6"/><ellipse cx="31" cy="24.6" rx="1.5" ry="2.6"/><ellipse cx="35.5" cy="27" rx="1.5" ry="2.6"/></svg>`; }
// Turbohélice (alas rectas + discos de hélice)
function planeTurboprop(fill,size,stroke){ return `<svg width="${size}" height="${size}" viewBox="0 0 48 48" fill="${fill}" ${stroke?`stroke="${stroke}" stroke-width="0.8" stroke-linejoin="round"`:''}><path d="M24 4c-1.3 0-2.3 1.3-2.3 3.2V20L6 23.5v3l15.7-2.6V37l-4.6 3.6V44L24 42l6.9 2v-3.4L26.3 37V23.9L42 26.5v-3L26.3 20V7.2C26.3 5.3 25.3 4 24 4z"/><ellipse cx="14" cy="22" rx="1.6" ry="2.4"/><ellipse cx="34" cy="22" rx="1.6" ry="2.4"/><path d="M14 17.6v8.8M34 17.6v8.8" stroke="${fill}" stroke-width="1.3" opacity="0.75"/></svg>`; }
// Helicóptero
function planeHeli(fill,size,stroke){ return `<svg width="${size}" height="${size}" viewBox="0 0 48 48" fill="${fill}" ${stroke?`stroke="${stroke}" stroke-width="0.8"`:''}><ellipse cx="24" cy="22" rx="5" ry="9"/><rect x="22.8" y="29" width="2.4" height="13" rx="1"/><rect x="18" y="40" width="12" height="2.4" rx="1"/><path d="M8 10L40 34M40 10L8 34" stroke="${fill}" stroke-width="2" opacity="0.8"/></svg>`; }
// Elige el ícono según el tipo de avión que reporta el simulador
function mePlaneSVG(){
  const s=lastState||{}, et=s.eng_type, n=s.eng_count||2;
  const C='#fbbf24';                       // amarillo, como en Flightradar
  if(et===1) return (n>=4) ? planeQuadJet(C,44,'#1e293b') : planeSilhouette(C,42,'#1e293b');
  if(et===5) return planeTurboprop(C,40,'#1e293b');
  if(et===3) return planeHeli(C,36,'#1e293b');
  return planeSVG(C,30,'#1e293b');        // pistón / desconocido
}
let acIconKey=null;
function updatePlaneIcon(s){
  const key=(s.eng_type==null?'x':s.eng_type)+'-'+(s.eng_count||0);
  if(key===acIconKey) return;
  acIconKey=key;
  if(meMarker) meMarker.getElement().innerHTML=mePlaneSVG();
}
function popup(html){ return new maplibregl.Popup({offset:16,closeButton:false}).setHTML(html); }
function acftEl(cls,svg,hdg){ const el=document.createElement('div'); el.innerHTML=`<div class="acft-inner ${cls}" style="transform:rotate(${hdg}deg)">${svg}</div>`; return el; }

let followMode=true, meMarker=null, meInner=null;
let aptMarkers=[], vorMarkers=[];
const flags={apt:true,vor:true};
let navRef=null, navAirports=[], navVors=[];
let aptRadius=60, lastAptCenter=null;   // radio de aeropuertos (NM)
let routeTarget=null;                    // {lat,lon,icao} destino de la ruta
let routeWaypoints=[], wpId=0;           // puntos de ruta intermedios {id,lat,lon,marker}
let lastGs=0;                            // última ground speed (kt), para el ETA de la ruta
let lastState=null;                      // último estado recibido, para prellenar el editor
let searchMarker=null, searchAirport=null;   // buscador de aeropuertos
let addWpMode=false;                     // modo "agregar punto de ruta" (evita puntos accidentales)

map.on('load',()=>{
  map.addSource('rw-fill',{type:'geojson',data:{type:'FeatureCollection',features:[]}});
  map.addSource('rw-center',{type:'geojson',data:{type:'FeatureCollection',features:[]}});
  // Las pistas también se funden con el zoom: de lejos son manchas ilegibles
  map.addLayer({id:'rw-fill',type:'fill',source:'rw-fill',paint:{'fill-color':'#0f172a','fill-outline-color':'#fff',
    'fill-opacity':['interpolate',['linear'],['zoom'],7,0,9.5,0.85]}});
  map.addLayer({id:'rw-center',type:'line',source:'rw-center',paint:{'line-color':'#fff','line-width':1.4,'line-dasharray':[3,3.5],
    'line-opacity':['interpolate',['linear'],['zoom'],7,0,9.5,0.85]}});
  map.addSource('flown',{type:'geojson',data:{type:'FeatureCollection',features:[]}});
  map.addLayer({id:'flown',type:'line',source:'flown',layout:{'line-cap':'round','line-join':'round'},paint:{'line-color':['get','color'],'line-width':5}});
  // Ruta directa a un aeropuerto (plan de vuelo simple)
  map.addSource('planroute',{type:'geojson',data:{type:'FeatureCollection',features:[]}});
  map.addLayer({id:'planroute-line',type:'line',source:'planroute',filter:['==',['geometry-type'],'LineString'],layout:{'line-cap':'round'},paint:{'line-color':'#a855f7','line-width':3,'line-dasharray':[2,2]}});
  map.addLayer({id:'planroute-pt',type:'circle',source:'planroute',filter:['all',['==',['geometry-type'],'Point'],['!',['has','ident']]],paint:{'circle-radius':6,'circle-color':'#a855f7','circle-stroke-color':'#fff','circle-stroke-width':2}});
  // Nombres de los VOR de la ruta generada. Al dibujarlos como capa del mapa (y no como
  // HTML encima) se comportan bien al inclinar la vista en 3D.
  map.addLayer({id:'planroute-wp',type:'symbol',source:'planroute',filter:['all',['==',['geometry-type'],'Point'],['has','ident']],layout:{'text-field':['get','ident'],'text-font':['Noto Sans Bold'],'text-size':12.5,'text-offset':[0,1.3],'text-anchor':'top','text-allow-overlap':true,'text-ignore-placement':true},paint:{'text-color':'#7dd3fc','text-halo-color':'rgba(10,10,20,0.92)','text-halo-width':2.4}});
  // 'line' + symbol-spacing repite la etiqueta a lo largo del trazo cada ~350 px de pantalla.
  // Con 'line-center' el texto vivía en el punto medio de la ruta: en un Cartagena-Boston
  // ese punto queda fuera de la vista y la etiqueta desaparecía.
  map.addLayer({id:'planroute-label',type:'symbol',source:'planroute',filter:['==',['geometry-type'],'LineString'],layout:{'symbol-placement':'line','symbol-spacing':350,'text-field':['get','label'],'text-font':['Noto Sans Bold'],'text-size':17,'text-allow-overlap':true,'text-ignore-placement':true,'text-keep-upright':true},paint:{'text-color':'#ffffff','text-halo-color':'rgba(10,10,20,0.9)','text-halo-width':2.8,'text-halo-blur':0.3}});
  // Plan de vuelo del propio MSFS (solo lectura) — línea magenta como la del GPS
  map.addSource('fplan',{type:'geojson',data:{type:'FeatureCollection',features:[]}});
  map.addLayer({id:'fplan-line',type:'line',source:'fplan',filter:['==',['geometry-type'],'LineString'],layout:{'line-cap':'round','line-join':'round'},paint:{'line-color':'#ff3df5','line-width':3.5,'line-opacity':0.9}});
  map.addLayer({id:'fplan-pt',type:'circle',source:'fplan',filter:['==',['geometry-type'],'Point'],paint:{'circle-radius':5,'circle-color':'#ff3df5','circle-stroke-color':'#fff','circle-stroke-width':2}});
  // Círculo del radio de aeropuertos
  map.addSource('aptcircle',{type:'geojson',data:{type:'FeatureCollection',features:[]}});
  map.addLayer({id:'aptcircle',type:'line',source:'aptcircle',paint:{'line-color':'#2f6df6','line-width':1.6,'line-dasharray':[3,3],'line-opacity':0.85}});
  // La etiqueta de la ruta va al tope de la pila: si no, la línea magenta del plan de
  // MSFS se dibuja encima y el texto queda tapado.
  map.moveLayer('planroute-label');
  map.moveLayer('planroute-wp');
  // El plan de vuelo del propio MSFS se sigue calculando y guardando (lo usa el chip de
  // abajo), pero no lo dibujamos: poné FPLAN_LINE_VISIBLE=true para volver a verlo.
  const v = FPLAN_LINE_VISIBLE ? 'visible' : 'none';
  map.setLayoutProperty('fplan-line','visibility',v);
  map.setLayoutProperty('fplan-pt','visibility',v);
  poll(); setInterval(poll,250);   // 4 lecturas por segundo
});

// El estado del seguimiento se ve en el botón de la barra (encendido/apagado),
// así que ya no hace falta el cartel de abajo.
function unfollow(){ if(!followMode) return;
  followMode=false;
  document.getElementById('btn-center').classList.remove('active'); }
map.on('dragstart',unfollow);
map.on('click',(e)=>{
  if(addWpMode && routeTarget){ addWaypoint(e.lngLat.lng, e.lngLat.lat); return; }   // modo agregar punto
  if(lpMarker) return;              // el clic viene de abrir el menú de pulsación larga
  unfollow();                       // un toque en el mapa suelta el seguimiento automático
});
function follow(){ followMode=true; document.getElementById('btn-center').classList.add('active'); }
document.getElementById('btn-center').onclick=()=>{
  if(followMode){ unfollow(); }
  else { follow(); if(meMarker) map.easeTo({center:meMarker.getLngLat()}); }
};

// ---- Plan de vuelo (ruta directa + teletransporte beta) ----
function haversineNM(la1,lo1,la2,lo2){ const R=3440.065,p1=la1*Math.PI/180,p2=la2*Math.PI/180,dp=(la2-la1)*Math.PI/180,dl=(lo2-lo1)*Math.PI/180;
  const a=Math.sin(dp/2)**2+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)**2; return 2*R*Math.asin(Math.sqrt(a)); }
// ---- Tiempo estimado, incluso con el avión parado ----
// Si todavía no despegaste no hay velocidad real, así que suponemos la de crucero
// típica según el tipo de motor que reporta el simulador.
const CRUISE_KT={1:450, 5:280, 3:110};      // 1=jet, 5=turbohélice, 3=helicóptero
const CRUISE_KT_DEFAULT=130;                 // pistón o desconocido
const CLIMB_DESC_MIN=15;                     // despegue y aterrizaje son mucho más lentos
function assumedKt(){ const t=(lastState||{}).eng_type; return CRUISE_KT[t]||CRUISE_KT_DEFAULT; }
function isRealSpeed(){ return !!(lastGs && lastGs>=40); }
function etaMinutes(nm){
  return isRealSpeed() ? (nm/lastGs*60) : (nm/assumedKt()*60 + CLIMB_DESC_MIN);
}
function fmtHm(min){ const h=Math.floor(min/60), m=Math.round(min%60);
  return (h>0? h+'h '+m+'m' : m+'m'); }
function routeEta(nm){ const min=etaMinutes(nm), hh=Math.floor(min/60), mm=Math.round(min%60);
  return (isRealSpeed()?'':'~')+String(hh).padStart(2,'0')+':'+String(mm).padStart(2,'0'); }
// Rumbo inicial (great circle) de un punto a otro, en grados verdaderos 0-359
function bearingTo(la1,lo1,la2,lo2){
  const p1=la1*Math.PI/180, p2=la2*Math.PI/180, dl=(lo2-lo1)*Math.PI/180;
  const y=Math.sin(dl)*Math.cos(p2);
  const x=Math.cos(p1)*Math.sin(p2)-Math.sin(p1)*Math.cos(p2)*Math.cos(dl);
  return (Math.atan2(y,x)*180/Math.PI+360)%360;
}
const CARDINALS=['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSO','SO','OSO','O','ONO','NO','NNO'];
function cardinal(deg){ return CARDINALS[Math.round(((deg%360)+360)%360/22.5)%16]; }
// Los rumbos calculados con coordenadas son VERDADEROS, pero la brújula del avión es
// MAGNÉTICA. En Colombia hay unos 7 grados de diferencia: por eso seguías el rumbo que
// decía la app y terminabas al costado del punto. Acá lo convertimos.
function toMag(deg){
  const mv=(lastState||{}).magvar;
  return ((deg - (mv||0)) % 360 + 360) % 360;
}
function fmtBrg(deg){ const m=toMag(deg);
  return String(Math.round(m)%360).padStart(3,'0')+'° '+cardinal(m); }
// Parte un tramo largo en pedacitos. Un segmento de cientos de millas se dibuja mal al
// alejar el zoom (la línea punteada llega a desaparecer), y además en un mapa plano una
// recta no es el camino real: densificando sigue el arco correcto y se ve siempre.
function densify(a, b, maxNm){
  const nm=haversineNM(a[1],a[0],b[1],b[0]);
  if(nm<=maxNm) return [b];
  const n=Math.min(64, Math.ceil(nm/maxNm)), out=[];
  for(let i=1;i<=n;i++){ const t=i/n;
    out.push([a[0]+(b[0]-a[0])*t, a[1]+(b[1]-a[1])*t]); }
  return out;
}
function drawRoute(){ if(!routeTarget) return;
  limpiarPuntosPasados();       // los puntos ya sobrevolados se sacan antes de dibujar
  // Si todavía no hay avión (por ejemplo al pegar una ruta con el sim cerrado), la ruta
  // igual se dibuja: arranca en su primer punto en vez de en el avión.
  const inicio = cur ? [cur.lng,cur.lat]
                     : (routeWaypoints.length ? [routeWaypoints[0].lon, routeWaypoints[0].lat]
                                              : [routeTarget.lon, routeTarget.lat]);
  const nodos=[inicio];
  routeWaypoints.forEach(w=>nodos.push([w.lon,w.lat]));   // puntos intermedios en orden
  nodos.push([routeTarget.lon,routeTarget.lat]);

  let nm=0; for(let i=0;i<nodos.length-1;i++){ nm+=haversineNM(nodos[i][1],nodos[i][0],nodos[i+1][1],nodos[i+1][0]); }
  // Rumbo al PRÓXIMO punto (no al destino final): es el que hay que volar ahora a mano
  const nx=nodos[1] || nodos[0];
  const brg=bearingTo(inicio[1],inicio[0],nx[1],nx[0]);

  const coords=[nodos[0]];
  for(let i=0;i<nodos.length-1;i++) densify(nodos[i],nodos[i+1],40).forEach(p=>coords.push(p));

  const feats=[
    {type:'Feature',properties:{label:nm.toFixed(0)+' NM | '+routeEta(nm)+' | '+fmtBrg(brg)},geometry:{type:'LineString',coordinates:coords}},
    {type:'Feature',geometry:{type:'Point',coordinates:[routeTarget.lon,routeTarget.lat]}}];
  routeWaypoints.forEach(w=>{ if(w.name) feats.push(
    {type:'Feature',properties:{ident:w.name},geometry:{type:'Point',coordinates:[w.lon,w.lat]}}); });
  map.getSource('planroute').setData({type:'FeatureCollection',features:feats});
  document.getElementById('route-chip').style.display='flex';
  document.getElementById('route-text').textContent='→ '+routeTarget.icao+' · '+nm.toFixed(0)+' NM · '+fmtBrg(brg);
  updateProgress(nm, brg);
}
// ---- Barra de progreso del vuelo (estilo Flightradar24) ----
// El origen se deduce del aeropuerto más cercano al primer punto de la ruta volada.
let originApt=null, originRefKey=null;
function findOriginAirport(){
  const r=(lastState&&lastState.route)||[];
  if(!r.length || !navAirports.length) return null;
  const key=r[0][0].toFixed(3)+','+r[0][1].toFixed(3);
  if(originRefKey===key && originApt) return originApt;   // cacheado: no recalcular cada tick
  let best=null,bestD=Infinity;
  navAirports.forEach(a=>{ const d=haversineNM(r[0][0],r[0][1],a.lat,a.lon);
    if(d<bestD){ bestD=d; best=a; } });
  if(best && bestD<25){ originRefKey=key; originApt=best; return best; }
  return null;
}
// Coordenadas legibles para los puntos sueltos (los que no son aeropuertos)
function fmtCoord(lat,lon){
  return Math.abs(lat).toFixed(2)+'° '+(lat>=0?'N':'S')+'  '+Math.abs(lon).toFixed(2)+'° '+(lon>=0?'E':'O');
}
// Arranca cerrado a propósito: se abre solo si lo pedís desde la barra de herramientas
let progressUserOn=false;
// Nombre del aeropuerto de destino, pedido por ICAO a la base completa (una sola vez)
let destInfo=null, destInfoPending=null;
function ensureDestInfo(icao){
  if(!icao || icao==='PUNTO') return;
  if(destInfo && destInfo.icao===icao) return;
  if(destInfoPending===icao) return;
  destInfoPending=icao;
  fetch('/api/airport?icao='+encodeURIComponent(icao)).then(r=>r.json())
    .then(a=>{ if(a && a.icao) destInfo=a; destInfoPending=null; })
    .catch(()=>{ destInfoPending=null; });
}
function syncProgressButton(){
  const b=document.getElementById('btn-progress'), el=document.getElementById('progress-panel');
  if(!b||!el) return;
  const avail=!!routeTarget;
  b.classList.toggle('disabled',!avail);
  b.classList.toggle('active', avail && progressUserOn);
  b.title = avail ? 'Progreso del vuelo' : 'Progreso del vuelo (necesita una ruta)';
  el.classList.toggle('hidden', !(avail && progressUserOn));
}
function updateProgress(nmLeft, brg){
  const el=document.getElementById('progress-panel'); if(!el) return;
  syncProgressButton();
  if(!routeTarget || !progressUserOn) return;

  const org=findOriginAirport();
  const r=(lastState&&lastState.route)||[];
  if(org){
    document.getElementById('pg-from').textContent=org.icao;
    document.getElementById('pg-from-name').textContent=org.name||'';
  }else{
    // Despegaste lejos de cualquier aeropuerto: lo tratamos como punto suelto
    document.getElementById('pg-from').textContent='PUNTO';
    document.getElementById('pg-from-name').textContent = r.length?fmtCoord(r[0][0],r[0][1]):'Origen desconocido';
  }

  const isPoint = routeTarget.icao==='PUNTO';
  document.getElementById('pg-to').textContent = routeTarget.icao;
  let toName='';
  if(isPoint){ toName=fmtCoord(routeTarget.lat, routeTarget.lon); }
  else{
    toName=(searchAirport&&searchAirport.icao===routeTarget.icao?searchAirport.name:(findApt(routeTarget.icao)||{}).name)||'';
    // Un destino lejano (ej. KBOS desde Cartagena) no está en los datos cargados alrededor
    // del avión, así que lo pedimos por ICAO a la base completa del backend.
    if(!toName){ ensureDestInfo(routeTarget.icao); toName=(destInfo&&destInfo.icao===routeTarget.icao?destInfo.name:'')||''; }
  }
  document.getElementById('pg-to-name').textContent = toName;

  const done=(lastState&&lastState.distance_nm)||0;      // recorrido real, no en línea recta
  const total=done+nmLeft;
  const pct=total>0?Math.max(0,Math.min(100,done/total*100)):0;
  document.getElementById('pg-fill').style.width=pct+'%';
  document.getElementById('pg-dot').style.left=pct+'%';
  document.getElementById('pg-done').innerHTML='<b>'+Math.round(done*1.852).toLocaleString('en-US')+' km</b> · '+Math.round(done)+' NM';
  document.getElementById('pg-left').innerHTML='<b>'+Math.round(nmLeft*1.852).toLocaleString('en-US')+' km</b> · '+Math.round(nmLeft)+' NM · '+routeEta(nmLeft);
  document.getElementById('pg-brg').textContent=fmtBrg(brg);

  // Llegada estimada: con el avión quieto usa la velocidad típica del tipo de avión;
  // apenas superás los 40 nudos pasa sola al cálculo con tu velocidad real.
  const etaEl=document.getElementById('pg-eta'), min=etaMinutes(nmLeft);
  const arr=new Date(Date.now()+min*60000);
  const est=!isRealSpeed();
  etaEl.textContent=(est?'~':'')+arr.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'  ·  '+fmtHm(min);
  etaEl.style.color = est ? 'var(--text-dim)' : 'var(--text)';
  etaEl.title = est ? ('Estimado suponiendo '+assumedKt()+' kt de crucero') : 'Calculado con tu velocidad real';
  updateNextLeg();
  updateVnav(nmLeft);
  updateVs(nmLeft);
  updateSpd();
  updateFaseIcono();
}

// El avioncito del panel se inclina según lo que estés haciendo: subiendo, nivelado o
// bajando. El ícono apunta al norte, así que girándolo se lee como una trayectoria.
function updateFaseIcono(){
  const ic=document.getElementById('pg-badge-icon'), b=document.getElementById('pg-badge');
  if(!ic) return;
  const vs=(lastState||{}).vs;
  let ang=90, txt='Nivelado', col='#fbbf24';       // 90° = mirando a la derecha
  if(vs!=null && vs>300){ ang=45;  txt='En ascenso';  col='#4ade80'; }
  else if(vs!=null && vs<-300){ ang=135; txt='En descenso'; col='#38bdf8'; }
  ic.style.transform='rotate('+ang+'deg)';
  ic.style.color=col;
  if(b) b.title=txt+(vs!=null?(' · '+(vs>=0?'+':'')+Math.round(vs)+' ft/min'):'');
}

// ---- Guía de descenso (regla 3:1 de los pilotos) ----
// Por cada 1000 pies a perder hacen falta 3 millas náuticas. No hace falta planificar
// ninguna altitud de crucero: se usa la que tenés en este momento.
function destElevFt(){
  const a=(destInfo&&destInfo.icao===routeTarget.icao)?destInfo:(findApt(routeTarget.icao)||{});
  const e=parseFloat(a.elev_ft);
  return isNaN(e)?0:e;
}
function updateVnav(nmLeft){
  const row=document.getElementById('pg-vnav-row'), el=document.getElementById('pg-vnav');
  const s=lastState||{};
  // Sin ruta a un aeropuerto, sin altitud, o en tierra, no hay nada que guiar
  if(!routeTarget || routeTarget.icao==='PUNTO' || s.alt==null || s.on_ground){ row.style.display='none'; return; }
  row.style.display='';

  const elev=destElevFt();
  const floor=elev+1500;                       // apuntamos a 1500 ft sobre el aeropuerto
  const toLose=Math.max(0, s.alt-floor);
  const needNm=toLose/1000*3;                  // la regla 3:1

  if(toLose<300){ el.textContent='Ya estás bajo'; el.style.color='var(--text-dim)'; return; }

  if(nmLeft > needNm+5){                       // todavía en crucero
    const faltaNm=nmLeft-needNm;
    el.textContent='Empezá en '+Math.round(faltaNm*1.852)+' km';
    el.style.color='var(--text)';
    row.querySelector('.pg-k').textContent='Inicio del descenso';
    return;
  }

  row.querySelector('.pg-k').textContent='Altura recomendada';
  const target=floor+(nmLeft/3)*1000;          // dónde deberías estar a esta distancia
  const diff=s.alt-target;
  const t=Math.round(target/100)*100;
  // Ir por encima del perfil sí importa (no llegás a bajar a tiempo). Ir por debajo no
  // es un problema, así que solo lo informamos cuando la diferencia es grande.
  if(diff>600){ el.textContent=nf(t)+' ft · vas '+nf(Math.round(diff/100)*100)+' alto'; el.style.color='#fb923c'; }
  else if(diff<-1500){ el.textContent=nf(t)+' ft · vas '+nf(Math.round(-diff/100)*100)+' bajo'; el.style.color='var(--text-dim)'; }
  else { el.textContent=nf(t)+' ft · en la senda'; el.style.color='#4ade80'; }
}

// Régimen de descenso necesario: cuántos pies por minuto hacen falta para llegar a la
// altura de aterrizaje justo a tiempo, con la velocidad que llevás ahora.
function updateVs(nmLeft){
  const row=document.getElementById('pg-vs-row'), el=document.getElementById('pg-vs');
  const s=lastState||{};
  if(!routeTarget || routeTarget.icao==='PUNTO' || s.alt==null || s.on_ground || !nmLeft){
    row.style.display='none'; return; }
  const perder=s.alt-(destElevFt()+1500);
  if(perder<300 || !lastGs || lastGs<40){ row.style.display='none'; return; }
  row.style.display='';
  const min=nmLeft/lastGs*60;                    // minutos que faltan al destino
  const fpm=Math.round(perder/Math.max(1,min)/50)*50;
  el.textContent='-'+nf(fpm)+' ft/min';
  // Más de 2000 ft/min de bajada es incómodo: significa que vas tarde
  el.style.color = fpm>2000 ? '#fb923c' : (fpm>0 ? '#4ade80' : 'var(--text-dim)');
  row.querySelector('.pg-k').textContent = fpm>2000 ? 'Bajar a (vas tarde)' : 'Bajar a';
}

// Velocidad recomendada. La regla real: por debajo de 10.000 pies no se pasa de 250 kt.
function updateSpd(){
  const row=document.getElementById('pg-spd-row'), el=document.getElementById('pg-spd');
  const s=lastState||{};
  if(s.alt==null || s.on_ground || s.ias==null){ row.style.display='none'; return; }
  row.style.display='';
  if(s.alt<10000){
    const exceso=s.ias-250;
    if(exceso>10){ el.textContent='máx 250 kt · vas '+Math.round(exceso)+' de más'; el.style.color='#fb923c'; }
    else { el.textContent='máx 250 kt bajo 10.000'; el.style.color='#4ade80'; }
  } else {
    el.textContent='libre sobre 10.000 ft'; el.style.color='var(--text-dim)';
  }
}

// ---- Cuánto falta para el próximo punto de la ruta ----
let legRefId=null, legRefNm=0;
// Al pasar por un punto de la ruta lo damos por cumplido y lo sacamos solo. El radio es
// chico (2,5 NM ≈ 4,6 km) para que solo cuente si realmente lo sobrevolaste.
const PASO_NM=2.5;
function limpiarPuntosPasados(){
  if(!cur || !routeWaypoints.length) return false;
  let saco=false;
  for(let i=routeWaypoints.length-1;i>=0;i--){
    const w=routeWaypoints[i];
    if(haversineNM(cur.lat,cur.lng,w.lat,w.lon)<=PASO_NM){
      w.marker.remove(); routeWaypoints.splice(i,1); saco=true;
      showToast('Pasaste '+(w.name||'el punto')+' · lo saqué de la ruta');
    }
  }
  return saco;
}
function nextLegTarget(){
  if(!cur||!routeTarget) return null;
  const toDest=haversineNM(cur.lat,cur.lng,routeTarget.lat,routeTarget.lon);
  // El primer waypoint que siga estando "adelante": si ya lo pasaste, ir hasta él y
  // después al destino daría un rodeo, así que lo salteamos.
  for(let i=0;i<routeWaypoints.length;i++){ const w=routeWaypoints[i];
    const via=haversineNM(cur.lat,cur.lng,w.lat,w.lon)+haversineNM(w.lat,w.lon,routeTarget.lat,routeTarget.lon);
    if(via<=toDest*1.15) return {key:'w'+w.id, lat:w.lat, lon:w.lon, name:w.name||'Punto de ruta'};
  }
  return null;   // ruta directa o ya pasaste todos: el destino ya lo muestra la barra de arriba
}
function updateNextLeg(){
  const row=document.getElementById('pg-next-row'); if(!row) return;
  const to=nextLegTarget();
  if(!to){ row.style.display='none'; return; }
  row.style.display='';
  const nm=haversineNM(cur.lat,cur.lng,to.lat,to.lon);
  if(legRefId!==to.key){ legRefId=to.key; legRefNm=nm; }   // tramo nuevo: guardamos su largo
  if(nm>legRefNm) legRefNm=nm;                              // te alejaste: reajustamos
  const pct=legRefNm>0 ? Math.max(0,Math.min(100,(1-nm/legRefNm)*100)) : 0;
  document.getElementById('pg-next-fill').style.width=pct+'%';
  document.getElementById('pg-next').textContent=
    to.name+' · '+Math.round(nm*1.852)+' km · '+Math.round(nm)+' NM · '+Math.round(etaMinutes(nm))+' min';
}

// ---- Mantener pulsado en el mapa => menú para trazar ruta a ese punto ----
const LONG_PRESS_MS=800;
let lpTimer=null, lpMarker=null;
function cancelLongPress(){ if(lpTimer){ clearTimeout(lpTimer); lpTimer=null; } }
function closePointMenu(){ if(lpMarker){ lpMarker.remove(); lpMarker=null; } }
function showPointMenu(lngLat){
  closePointMenu();
  const el=document.createElement('div'); el.className='lp-menu glass';
  // Si ya hay una ruta activa, ofrecemos además meterlo como punto intermedio
  el.innerHTML='<button class="lp-btn lp-go">Ir hacia aquí</button>'
    +(routeTarget?'<button class="lp-btn lp-wp">＋ Punto</button>':'')
    +'<button class="lp-btn lp-x">✕</button>';
  el.querySelector('.lp-go').onclick=()=>{
    routeWaypoints.forEach(w=>w.marker.remove()); routeWaypoints=[];   // destino nuevo => waypoints viejos ya no aplican
    routeTarget={lat:lngLat.lat, lon:lngLat.lng, icao:'PUNTO'};
    msfsPlanAuto=false;                      // ruta puesta a mano: manda sobre la de MSFS
    drawRoute(); showArrivalToast(); closePointMenu();
  };
  const wp=el.querySelector('.lp-wp');
  if(wp) wp.onclick=()=>{ addWaypoint(lngLat.lng, lngLat.lat); closePointMenu(); };
  el.querySelector('.lp-x').onclick=closePointMenu;
  lpMarker=new maplibregl.Marker({element:el, anchor:'bottom', offset:[0,-12]}).setLngLat(lngLat).addTo(map);
}
function armLongPress(e){
  cancelLongPress();
  const at=e.lngLat;
  lpTimer=setTimeout(()=>{ lpTimer=null; showPointMenu(at); }, LONG_PRESS_MS);
}
map.on('mousedown', armLongPress);
map.on('touchstart', armLongPress);
// Solo cancelamos con acciones del usuario: el mapa se mueve solo al seguir al avión,
// así que NO podemos cancelar con 'move' o el menú nunca aparecería en vuelo.
map.on('mouseup', cancelLongPress);
map.on('touchend', cancelLongPress);
map.on('touchmove', cancelLongPress);
map.on('dragstart', cancelLongPress);
map.on('zoomstart', cancelLongPress);

// Cabecera del panel: un clic lo pliega/despliega, arrastrarla lo suelta del stack izquierdo.
(function(){
  const panel=document.getElementById('progress-panel'), head=document.getElementById('pg-head');
  if(!panel||!head) return;
  const stack=document.getElementById('tools');   // su lugar natural: columna de la derecha
  let dragging=false, moved=false, startX=0, startY=0, offX=0, offY=0;

  function startDrag(cx,cy){
    const r=panel.getBoundingClientRect();
    dragging=true; moved=false;
    startX=cx; startY=cy; offX=cx-r.left; offY=cy-r.top;
  }
  function moveDrag(cx,cy){
    if(!dragging) return;
    if(!moved){
      if(Math.abs(cx-startX)+Math.abs(cy-startY)<4) return;   // umbral: clic vs arrastre
      moved=true;
      // Lo sacamos del stack y lo colgamos del body: dentro del stack, position:fixed
      // no se despega bien y el panel quedaba clavado.
      const r=panel.getBoundingClientRect();
      document.body.appendChild(panel);
      panel.classList.add('floating');
      panel.style.left=r.left+'px'; panel.style.top=r.top+'px';
    }
    const w=panel.offsetWidth, h=panel.offsetHeight;
    let x=Math.max(0,Math.min(window.innerWidth-w, cx-offX));
    let y=Math.max(0,Math.min(window.innerHeight-h, cy-offY));
    panel.style.left=x+'px'; panel.style.top=y+'px';
  }
  // La cabecera solo arrastra. Abrir y cerrar es exclusivo del botón de la barra de
  // herramientas: tener dos mecanismos (plegar + ocultar) se pisaba entre sí.
  function endDrag(){ dragging=false; }
  head.addEventListener('mousedown',e=>{ startDrag(e.clientX,e.clientY); e.preventDefault(); });
  window.addEventListener('mousemove',e=>moveDrag(e.clientX,e.clientY));
  window.addEventListener('mouseup',endDrag);
  head.addEventListener('touchstart',e=>{ const t=e.touches[0]; startDrag(t.clientX,t.clientY); },{passive:true});
  window.addEventListener('touchmove',e=>{ if(dragging){ const t=e.touches[0]; moveDrag(t.clientX,t.clientY); } },{passive:true});
  window.addEventListener('touchend',endDrag);

  head.addEventListener('dblclick',()=>{                 // doble clic: volver a la columna izquierda
    if(!panel.classList.contains('floating')) return;
    panel.classList.remove('floating');
    panel.style.left=''; panel.style.top='';
    if(stack) stack.appendChild(panel);   // vuelve debajo de la barra de herramientas
  });
})();

// ---- Plan de vuelo armado en el mapa del mundo de MSFS (pre-partida) ----
// El backend lee CustomFlight.PLN. Si el juego trae un destino y vos todavía no
// pusiste una ruta propia, la app la adopta sola.
let msfsPlanKey=null, msfsPlanAuto=false;
function checkMsfsPlan(){
  fetch('/api/msfs_plan').then(r=>r.json()).then(p=>{
    if(!p.ok || p.dest_lat==null) return;
    const key=p.departure+'>'+p.destination+'@'+p.mtime;
    if(key===msfsPlanKey) return;                    // este plan ya lo procesamos
    msfsPlanKey=key;
    if(routeTarget && !msfsPlanAuto) return;         // pusiste la tuya a mano: no la pisamos

    // MSFS deja este archivo intacto si arrancás un vuelo sin ruta, así que puede ser de
    // una partida vieja. Lo damos por válido solo si es reciente Y estás parado en su
    // aeropuerto de salida. Si no, es un fantasma y lo ignoramos.
    if(p.age_h!=null && p.age_h>6) return;
    if(p.dep_lat!=null && cur){
      if(haversineNM(cur.lat, cur.lng, p.dep_lat, p.dep_lon) > 30) return;
    }
    routeWaypoints.forEach(w=>w.marker.remove()); routeWaypoints=[];
    routeTarget={lat:p.dest_lat, lon:p.dest_lon, icao:p.destination};
    msfsPlanAuto=true;
    showToast('Plan de MSFS detectado · '+p.departure+' → '+p.destination);
    if(cur){ drawRoute(); }
  }).catch(()=>{});
}
