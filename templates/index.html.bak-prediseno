        <div class="pg-next-head"><span class="pg-k">Próximo punto</span><span class="pg-v" id="pg-next">--</span></div>
        <div class="pg-next-track"><span class="pg-next-fill" id="pg-next-fill"></span></div>
      </div>
    </div>
  </div>
</div>

<div id="compass" class="glass" title="Volver al norte">
  <svg id="compass-rose" width="30" height="30" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="14" fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="1"/>
    <path d="M16 5 L20 17 L16 15 L12 17 Z" fill="#ef4444"/>
    <path d="M16 27 L12 15 L16 17 L20 15 Z" fill="#e6eaf2"/>
